# Base URL of the Job Portal API.
#
# Default (development / preview): leave this unset. The app calls "/api" on its
# own origin and the Vite dev/preview server proxies it to the backend below.
# That avoids the API's CORS allow-list entirely.
#
# Production: build with an absolute URL, e.g.
#   VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=/api

# Where the dev/preview proxy forwards /api to (development only).
VITE_PROXY_TARGET=http://localhost:5001
