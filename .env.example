# Copy to .env for local development; restart Vite after changes.
VITE_API_URL=/api
VITE_PROXY_TARGET=https://job-back-end.onrender.com
# Proxy preserves Origin; backend CLIENT_ORIGIN must include http://localhost:5180.
# Do not append /api to VITE_PROXY_TARGET.
# For a local backend instead: VITE_PROXY_TARGET=http://localhost:5001
# Production static hosting: set VITE_API_URL=https://job-back-end.onrender.com/api
# BEFORE building. The Vite proxy is not included in dist.
# Never put database credentials or JWT keys in VITE_*.
